# go-frog MCP configuration template.
# Copy this file to .env and adjust values locally. .env is gitignored and must
# never be committed. Authentication stays at the deployment's oauth2-proxy;
# no app-level tokens or secrets belong in this file.

# MCP server (off by default)
GOFROG_MCP_ENABLED=false
GOFROG_MCP_PATH=/mcp

# Job retention and artifacts
GOFROG_MCP_JOB_TTL=24h
GOFROG_MCP_RESULTS_DIR=/results

# Server-enforced limits
GOFROG_MCP_MAX_PAGES=5000
GOFROG_MCP_MAX_DEPTH=10
GOFROG_MCP_MAX_LIST_URLS=1000
GOFROG_MCP_MAX_DURATION=30m
GOFROG_MCP_MAX_JOBS=4
GOFROG_MCP_MAX_JOBS_PER_TOKEN=2
GOFROG_MCP_RATE_LIMIT=60

# Default crawl behavior
GOFROG_MCP_DEFAULT_ARCHIVE=false

# Public base URL used when returning artifact links
GOFROG_MCP_ARTIFACT_BASE_URL=https://crawler.example.com
